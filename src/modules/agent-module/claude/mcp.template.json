{
  "mcpServers": {
    "codehydra": {
      "type": "stdio",
      "command": "${NODE_PATH}",
      "args": ["${CLI_PATH}", "mcp"],
      "env": {
        "_CH_WORKSPACE_PATH": "${WORKSPACE_PATH}",
        "_CH_PLUGIN_PORT": "${PLUGIN_PORT}",
        "_CH_PLUGIN_TOKEN": "${PLUGIN_TOKEN}"
      }
    }
  }
}
