{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": "..",
    "outDir": "../../out",
    "paths": {
      "$lib/*": ["./lib/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "../env.d.ts",
    "./**/*",
    "../shared/**/*",
    "../intents/contract.ts",
    "../utils/path/path.ts",
    "../test/**/*"
  ],
  "exclude": [
    "../../node_modules",
    "../../app-data",
    "../test/setup-matchers.ts",
    "../test/global-setup-boundary.ts"
  ]
}
