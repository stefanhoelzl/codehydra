{
	"name": "markdown-review-editor",
	"displayName": "Markdown Review Editor",
	"description": "AI-assisted collaborative markdown document editor",
	"version": "0.1.0-dev.6686f318",
	"type": "module",
	"publisher": "codehydra",
	"repository": {
		"type": "git",
		"url": "https://github.com/stefanhoelzl/codehydra"
	},
	"engines": {
		"vscode": "^1.108.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "markdownReviewEditor.open",
				"title": "Open Markdown Review Editor",
				"category": "Markdown Review"
			}
		],
		"customEditors": [
			{
				"viewType": "markdownReviewEditor.editor",
				"displayName": "Markdown Review Editor",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		]
	},
	"scripts": {
		"build": "vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write ."
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/diff-match-patch": "^1.0.36",
		"@types/marked": "^6.0.0",
		"@types/node": "^26.6.3",
		"@types/turndown": "^5.0.6",
		"@types/vscode": "~1.108.1",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@opencode-ai/sdk": "^1.18.33",
		"diff-match-patch": "^1.0.5",
		"marked": "^18.0.14",
		"turndown": "^7.2.4"
	}
}
