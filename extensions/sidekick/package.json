{
  "name": "sidekick",
  "displayName": "CodeHydra Sidekick",
  "description": "CodeHydra integration for VS Code",
  "version": "1.0.0-placeholder",
  "type": "module",
  "publisher": "codehydra",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanhoelzl/codehydra"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "color-name": "^2.1.1",
    "socket.io-client": "^4.8.4"
  },
  "contributes": {
    "commands": [
      {
        "command": "codehydra.restartAgentServer",
        "title": "Restart Agent Server",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.openAgent",
        "title": "Open Agent",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.closeAgent",
        "title": "Close Agent",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.getTags",
        "title": "Get Tags",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.setTag",
        "title": "Set Tag",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.deleteTag",
        "title": "Delete Tag",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.getMetadata",
        "title": "Get Metadata",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.setMetadata",
        "title": "Set Metadata",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.deleteMetadata",
        "title": "Delete Metadata",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.openWithDefaultApp",
        "title": "Open with Default Application",
        "category": "CodeHydra"
      },
      {
        "command": "codehydra.debug.getStatus",
        "title": "CodeHydra Debug: Get Workspace Status",
        "enablement": "codehydra.isDevelopment"
      },
      {
        "command": "codehydra.debug.getAgentSession",
        "title": "CodeHydra Debug: Get Agent Session",
        "enablement": "codehydra.isDevelopment"
      },
      {
        "command": "codehydra.debug.connectionInfo",
        "title": "CodeHydra Debug: Show Connection Info",
        "enablement": "codehydra.isDevelopment"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codehydra.revealInFileExplorer",
          "group": "navigation@20"
        },
        {
          "command": "codehydra.openWithDefaultApp",
          "group": "navigation@21",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codehydra.openAgent",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b[13;2u"
        },
        "when": "terminalEditorFocus && codehydra.terminalForward =~ /\"shift\\+enter\"/i"
      },
      {
        "key": "ctrl+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b[13;5u"
        },
        "when": "terminalEditorFocus && codehydra.terminalForward =~ /\"ctrl\\+enter\"/i"
      },
      {
        "key": "ctrl+shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b[13;6u"
        },
        "when": "terminalEditorFocus && codehydra.terminalForward =~ /\"ctrl\\+shift\\+enter\"/i"
      },
      {
        "key": "shift+space",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b[32;2u"
        },
        "when": "terminalEditorFocus && codehydra.terminalForward =~ /\"shift\\+space\"/i"
